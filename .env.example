# Copy this file to .env.local for local testing. On Netlify, add the same names under
# Project configuration -> Environment variables. See CLIENT_SETUP.md.

# --- Supabase (Project Settings -> API / API Keys) -------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only: full admin access to the database. Never put it in a NEXT_PUBLIC_ variable or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key

# --- The firm (all optional; defaults are the Prime Estates demo) ----------
NEXT_PUBLIC_FIRM_NAME=Sea Breeze Realtors
NEXT_PUBLIC_FIRM_CITY=Mumbai
NEXT_PUBLIC_FIRM_PHONE=+91 98200 12345
# Only if WhatsApp is on a different number from the phone above
# NEXT_PUBLIC_FIRM_WHATSAPP=+91 98200 54321
NEXT_PUBLIC_FIRM_EMAIL=hello@seabreezerealtors.in
NEXT_PUBLIC_FIRM_ADDRESS=Shop 3, Lokhandwala Complex, Andheri West, Mumbai 400053
NEXT_PUBLIC_FIRM_HOURS=Monday to Saturday, 10 am to 7 pm
NEXT_PUBLIC_FIRM_LOCALITIES=Andheri West, Bandra West, Powai, Juhu, Goregaon
NEXT_PUBLIC_FIRM_FOUNDED_YEAR=2015
# The firm's real MahaRERA agent number. Leave unset and every MahaRERA mention is hidden.
NEXT_PUBLIC_FIRM_RERA_NO=
# Optional logo image (a full https:// link). Leave unset for the built-in house icon.
NEXT_PUBLIC_FIRM_LOGO_URL=

# true only on YOUR demo sites: shows sample testimonials and a sample team.
NEXT_PUBLIC_DEMO_CONTENT=false
