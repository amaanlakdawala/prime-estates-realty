# Copy this file to .env.local and fill in the values from
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Settings -> API Keys -> Secret keys. Server-only: gives full admin access to
# your database and lets the admin panel create employee logins.
# NEVER put this in a NEXT_PUBLIC_ variable or commit it - it must stay secret.
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key
