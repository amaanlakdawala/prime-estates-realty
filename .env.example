# Copy this file to .env.local for local testing. On Netlify, add the same names under
# Project configuration -> Environment variables.
# Firm details (name, phone, city…) are NOT set here: each firm is a record in the database,
# created and edited in the admin panel under Firms. See CLIENT_SETUP.md.

# --- Supabase (Project Settings -> API / API Keys) -------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only: full admin access to the database. Never put it in a NEXT_PUBLIC_ variable or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key

# --- Lead finder (admin panel -> Leads) --------------------------------------
# Google Cloud -> APIs & Services -> Credentials. Restrict the key to "Places API (New)".
# Server-only: never put it in a NEXT_PUBLIC_ variable.
GOOGLE_PLACES_API_KEY=your-places-api-key
# The lead finder stops searching once this many Google requests have been made in a month.
# Keep it under Google's free monthly allowance for Text Search with phone and website fields.
# LEADS_MONTHLY_REQUEST_LIMIT=900

# --- AI calling (admin panel -> AI calls) -----------------------------------
# ElevenLabs API key, the two Riya agents (Sia / Simran voice) and the imported phone number. Server-only.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_AGENT_ID_SIA=agent_...
ELEVENLABS_AGENT_ID_SIMRAN=agent_...
ELEVENLABS_PHONE_NUMBER_ID=phnum_...

# --- Optional ---------------------------------------------------------------
# Your brand, shown on the sign-in page and admin panel.
# NEXT_PUBLIC_PLATFORM_NAME=Prime Estates Realty
# The firm shown at the site root (/). Defaults to your demo firm.
# NEXT_PUBLIC_DEFAULT_FIRM_SLUG=prime-estates
